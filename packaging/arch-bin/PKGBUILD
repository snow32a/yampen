pkgname=yampen-bin
pkgver=0.14.1
pkgrel=1
arch=('x86_64')
url="https://github.com/snow32a/yampen"
license=('GPLv3')
depends=('gtk4')
provides=('yampen')
conflicts=('yampen')
source=("$url/releases/download/v$pkgver/yampen-v$pkgver-linux-x86_64.tar.gz")
sha256sums=('SKIP')

package() {
  install -Dm755 usr/bin/yampen "$pkgdir/usr/bin/yampen"
  install -Dm644 usr/share/applications/yampen.desktop "$pkgdir/usr/share/applications/yampen.desktop"
}